# API server port
PORT=3001

# Postgres connection string (matches infra/docker-compose.yml defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loltracker?schema=public

# Redis connection string (used by the background worker / queue)
REDIS_URL=redis://localhost:6379

# Riot Games API key — get one at https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Default regional routing for match-v5 (americas | europe | asia | sea)
RIOT_REGION_ROUTING=americas

# Allowed browser origin(s) for CORS, comma-separated
CORS_ORIGIN=http://localhost:3000

# development | production | test
NODE_ENV=development
