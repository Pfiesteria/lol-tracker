{
  "name": "lol-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "League of Legends match tracker (NestJS API + Next.js web + Prisma/Postgres)",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev:api": "pnpm --filter @app/api start:dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @app/api test",
    "db:generate": "pnpm --filter @repo/db generate",
    "db:migrate": "pnpm --filter @repo/db migrate",
    "db:deploy": "pnpm --filter @repo/db migrate:deploy",
    "db:studio": "pnpm --filter @repo/db studio"
  }
}
