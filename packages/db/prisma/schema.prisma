generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RiotAccount {
  id        String   @id @default(cuid())
  puuid     String   @unique
  gameName  String
  tagLine   String
  region    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants MatchParticipant[]
}

enum MatchIngestStatus {
  PENDING
  INGESTED
  FAILED
}

model Match {
  id          String            @id // Riot matchId (e.g. NA1_123...)
  status      MatchIngestStatus @default(PENDING)
  firstSeenAt DateTime          @default(now())
  ingestedAt  DateTime?
  lastError   String?

  // Optional so a row can be inserted before full details are ingested.
  // `status` gates reads: only INGESTED matches are guaranteed to have these set.
  queueId     Int?
  gameStartAt DateTime?
  durationSec Int?
  patch       String?
  raw         Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants MatchParticipant[]
}

model MatchParticipant {
  id         String  @id @default(cuid())
  matchId    String
  riotAccId  String

  championId Int
  teamId     Int
  win        Boolean

  kills      Int
  deaths     Int
  assists    Int

  lane       String?
  role       String?

  match      Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  riotAcc    RiotAccount @relation(fields: [riotAccId], references: [id], onDelete: Cascade)

  // The unique composite already indexes (matchId) and (matchId, riotAccId),
  // so no separate indexes are needed for those. riotAccId drives all per-account
  // read queries; (matchId, championId) supports champion lookups within a match.
  @@unique([matchId, riotAccId])
  @@index([riotAccId])
  @@index([matchId, championId])
}
